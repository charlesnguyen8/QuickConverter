{
  "name": "quickconverter",
  "version": "1.0.0",
  "description": "Chrome Extension for QuickConverter",
  "scripts": {
    "dev": "vite",
    "build:ext": "vite build",
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./styles/tailwind.css --watch",
    "test": "node tests/run_all.js"
