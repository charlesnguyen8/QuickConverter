{
  "manifest_version": 3,
  "name": "QuickConverter",
  "version": "1.0.0",
  "description": "QuickConverter Chrome Extension",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://wetriedtls.com/*",
    "*://www.wetriedtls.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://wetriedtls.com/series/*",
        "*://www.wetriedtls.com/series/*"
      ],
      "js": [
        "providers/wetriedtls.js",
        "providers/registry.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
